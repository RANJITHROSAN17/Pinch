{
  "name": "pinch",
  "version": "1.0.0",
  "private": true,
  "description": "Pinch \ud83e\udd9e \u2014 a private, local-first personal AI assistant you message from Telegram, Discord, Slack, WhatsApp or the browser, with voice on your phone.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pinch": "./bin/pinch.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "setup": "node scripts/setup.js",
    "doctor": "node scripts/setup.js --check",
    "test": "node --test",
    "demo": "node scripts/demo.js",
    "pair": "node scripts/pair.js",
    "brain": "node scripts/braincheck.js",
    "service": "node scripts/service.js",
    "supervise": "node scripts/supervise.js",
    "audit": "node scripts/audit.js",
    "radar": "node scripts/tech-radar.js",
    "verify": "node --test && node scripts/audit.js"
  },
  "optionalDependencies": {
    "@whiskeysockets/baileys": "^6.7.16",
    "qrcode-terminal": "^0.12.0"
  },
  "keywords": [
    "ai-assistant",
    "local-first",
    "ollama",
    "telegram",
    "discord",
    "slack",
    "whatsapp",
    "mcp"
  ],
  "license": "MIT"
}
